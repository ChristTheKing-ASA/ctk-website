# Keystatic GitHub Mode
# Create a GitHub OAuth App at https://github.com/settings/developers
# Callback URL: https://your-domain/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Admin authentication (protects /admin and /keystatic)
# ADMIN_PASSWORD is required
# ADMIN_SESSION_SECRET should be a long random string
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Email Service (Resend) - https://resend.com
# DO NOT put your real API key here. Copy this file to .env.local and set the key there.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=website@ctkasa.com
ADMIN_EMAIL=thusberg@bellsouth.net

# Cloudflare (for deployment and D1 database)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps (public — Maps Embed API for Visit & Contact pages)
# https://console.cloud.google.com/apis/library/maps-backend.googleapis.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# YouTube (server-side only — for sermon feed on /worship/sermons)
# Enable "YouTube Data API v3" on the same Google Cloud project
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UC3qXOkET13YuCc4dNr89Q2w
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@christthekinganglicanstaugustine
