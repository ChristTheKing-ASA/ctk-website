{
  "name": "ctk-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:resend": "node --env-file=.env.local scripts/test-resend.mjs",
    "test:youtube": "node --env-file=.env.local scripts/test-youtube.mjs",
    "check:config": "node scripts/check-config.mjs",
    "db:setup": "node scripts/setup-d1.mjs",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 execute ctk-website-db --local --file=./drizzle/migrations/0000_initial.sql",
    "db:migrate:remote": "wrangler d1 execute ctk-website-db --remote --file=./drizzle/migrations/0000_initial.sql",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@keystatic/core": "^0.5.48",
    "@keystatic/next": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250423.0",
    "@opennextjs/cloudflare": "^1.16.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "wrangler": "^4.63.0"
  }
}
